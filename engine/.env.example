# API and workers use the same configuration. No AI key is needed for reading or text posting.
DATABASE_URL=postgresql+psycopg://kiez:kiez@127.0.0.1:5432/kiez
ENVIRONMENT=development
PUBLIC_ORIGIN=http://localhost:3001
SESSION_SECRET=
CRON_SECRET=
ADMIN_SECRET=
DEMO_DATA=true
DEMO_ANCHOR_DATE=

TRANSCRIPTION_PROVIDER=gemini
TRANSLATION_PROVIDER=gemini
DETECTION_PROVIDER=gemini
CHRONICLE_PROVIDER=openai
TTS_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
OPENAI_API_KEY=
OPENAI_CHRONICLE_MODEL=gpt-4.1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
ENABLED_AUDIO_LANGUAGES=en,de,tr,ar,es
PROVIDER_TIMEOUT_SECONDS=90
INTERACTIVE_CONCURRENCY=4
CHRONICLE_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_TTL_SECONDS=900
WORKER_POLL_SECONDS=1
SCHEDULER_INTERVAL_SECONDS=300
AI_DAILY_TASK_LIMIT=2000
